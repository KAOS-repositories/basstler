{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh plan.agentic_loop.stop_hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh review_triage.stop_hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh plan_site.attach_approval",
            "type": "command"
          }
        ],
        "matcher": "mcp__claude-code-remote__add_repo"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh plan_site.entry_point_approval",
            "if": "Bash(*basstler.sh*)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
