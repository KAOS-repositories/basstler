{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh --hook playbook.skills_command",
            "if": "Bash(*basstler.sh*)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
