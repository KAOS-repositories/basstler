{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*basstler.sh*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/basstler.sh playbook.skills_command"
          }
        ]
      }
    ]
  }
}
